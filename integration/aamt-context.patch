+"""Wiring for aamt-context: shared memory + context management for the team.
+
+The orchestrator builds one bridge per run. The bridge listens to the event bus (events
+become shared memory), builds each task's supporting context, and hands the task graph
+per-task hooks (tool-output clipping, transcript condensation, attempt memory).
+"""
+
+from __future__ import annotations
+
+from aamt_context import BudgetConfig, ContextConfig, ContextEngine
+from aamt_context.integrations.aamt import AamtContextBridge
+from aamt_context.integrations.langchain import LangChainTextLLM
+
+from .config import Settings
+from .events.bus import EventBus
+from .llm.provider import build_chat_model
+from .state.store import ProjectStore
+
+
+class _LazyLLM:
+    """Build the summariser model on first use, so no API key is needed to start a run.
+
+    Summaries and minutes fall back to deterministic extraction if this raises.
+    """
+
+    def __init__(self, settings: Settings):
+        self._settings = settings
+        self._llm: LangChainTextLLM | None = None
+
+    def complete(self, system: str, prompt: str, *, max_tokens: int = 1024) -> str:
+        if self._llm is None:
+            self._llm = LangChainTextLLM(
+                build_chat_model(model=self._settings.coordinator_model, settings=self._settings)
+            )
+        return self._llm.complete(system, prompt, max_tokens=max_tokens)
+
+
+def build_context_bridge(settings: Settings, store: ProjectStore, bus: EventBus) -> AamtContextBridge:
+    config = ContextConfig(
+        budget=BudgetConfig(
+            window_tokens=settings.context_window_tokens,
+            reserve_output_tokens=settings.llm_max_tokens,
+        ),
+        brief_tokens=settings.context_brief_tokens,
+    )
+    engine = ContextEngine.open(settings.context_db_path, config=config, llm=_LazyLLM(settings))
+    # the task graph records attempts through the task context, so skip the event fallback
+    bridge = AamtContextBridge(engine, memory_tools=settings.context_memory_tools, attempts_from_events=False)
+    bridge.attach(bus, store=store)
+    return bridge
