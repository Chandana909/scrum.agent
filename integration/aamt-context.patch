diff --git a/tests/test_context_integration.py b/tests/test_context_integration.py
new file mode 100644
index 0000000..5fafa09
--- /dev/null
+++ b/tests/test_context_integration.py
@@ -0,0 +1,157 @@
+"""aamt-context wiring: attempt memory, agent instrumentation, briefs from shared memory."""
+
+from __future__ import annotations
+
+import pytest
+from langchain_core.messages import AIMessage, HumanMessage
+
+from aamt.agents.base import AgentRunResult, BaseAgent
+from aamt.config import Settings
+from aamt.models import Project, Task, TaskStatus
+from aamt.models.agent import AgentSpec
+from aamt.planning.schemas import (
+    BacklogPlan, PlannedCriterion, PlannedFeature, PlannedStory, PlannedTask,
+)
+from aamt.runtime import task_graph as tg
+from aamt.runtime.task_graph import TaskRunResult
+from aamt.runtime.verification import VerificationReport
+from aamt.tools.test_runner import TestOutcome
+from aamt.tools.workspace import Workspace
+from aamt_context import ContextEngine
+from aamt_context.integrations.aamt import AamtContextBridge
+
+
+def _settings(tmp_path, **kw) -> Settings:
+    return Settings(data_dir=tmp_path / "d", workspace_dir=tmp_path / "w",
+                    test_command="python -m pytest -q", **kw)
+
+
+def test_failed_verification_is_remembered_for_the_retry(tmp_path, monkeypatch):
+    repo = Workspace(tmp_path / "repo")
+    repo.ensure_git_repo()
+    repo.write_file("README.md", "x\n")
+    repo.commit_all("init")
+    engine = ContextEngine.open(tmp_path / "context.db")
+    project = Project(name="p", problem_statement="demo", repo_path=str(repo.root))
+    task = Task(title="add feature", role="backend")
+    ctx = AamtContextBridge(engine).task_context(project, task)
+    seen: list[str] = []
+
+    class FakeAgent:
+        def __init__(self, *a, **k):
+            assert k.get("context") is ctx
+        def implement(self, task, ws, **kw):
+            seen.append(kw["extra_context"])
+            ws.write_file(f"src/impl_{len(seen)}.py", "x = 1\n")
+            return AgentRunResult(ok=True, summary="done", steps=1, tool_calls=["write_file"])
+
+    verdicts = [False, True]
+
+    def fake_verify(task, ws, **kw):
+        ok = verdicts.pop(0)
+        return VerificationReport(implementation_present=True, diff_stat="1 file", tests_required=True,
+                                  tests=TestOutcome(command="pytest", ran=True, passed=ok, exit_code=0 if ok else 1,
+                                                    n_passed=1 if ok else 0, n_failed=0 if ok else 1))
+
+    monkeypatch.setattr(tg, "DeveloperAgent", FakeAgent)
+    monkeypatch.setattr(tg, "verify_task", fake_verify)
+    res = tg.run_task(task, workspace_root=str(repo.root), agent_role="backend",
+                      settings=_settings(tmp_path), context=ctx)
+    assert res.ok and res.attempts == 2
+    assert seen[0] == ""
+    assert seen[1].startswith("Earlier attempts on this task:\nAttempt 1 — verify_failed")
+    assert "did NOT pass verification" in seen[1]
+    assert [r.data["outcome"] for r in engine.attempts(ctx.reader)] == ["verify_failed"]
+    engine.close()
+
+
+def test_base_agent_run_is_instrumented(monkeypatch):
+    calls = {}
+
+    class StubContext:
+        def instrument(self, tools):
+            calls["instrument"] = list(tools)
+            return ["wrapped"], "HOOK"
+        def finish_run(self, messages):
+            calls["finished"] = len(messages)
+
+    class FakeGraph:
+        def invoke(self, state, config=None):
+            return {"messages": [*state["messages"], AIMessage(content="Implemented it; tests pass.")]}
+
+    def fake_create(model, tools, **kw):
+        calls["tools"], calls["hook"] = tools, kw.get("pre_model_hook")
+        return FakeGraph()
+
+    monkeypatch.setattr("aamt.agents.base.create_react_agent", fake_create)
+    monkeypatch.setattr(BaseAgent, "_model", lambda self: None)
+    agent = BaseAgent(AgentSpec(role="backend", title="Backend"), context=StubContext())
+    res = agent.run("do it", tools=["t1"])
+    assert calls == {"instrument": ["t1"], "tools": ["wrapped"], "hook": "HOOK", "finished": 3}
+    assert res.summary == "Implemented it; tests pass."
+
+
+def test_orchestrator_briefs_come_from_shared_memory(tmp_path, monkeypatch):
+    plan = BacklogPlan(epic="Task list", features=[PlannedFeature(title="Core", stories=[PlannedStory(
+        title="Store", tasks=[
+            PlannedTask(ref="t1", title="Create store module", description="in-memory store", role="backend",
+                        priority="HIGH", estimate=2, acceptance_criteria=[PlannedCriterion(text="module exists")]),
+            PlannedTask(ref="t2", title="Add tests for store", description="pytest", role="qa", priority="HIGH",
+                        estimate=2, depends_on=["t1"], acceptance_criteria=[PlannedCriterion(text="tests pass")]),
+        ])])])
+    monkeypatch.setattr("aamt.agents.scrum_master.BacklogPlanner.generate", lambda self, project: plan)
+    monkeypatch.setattr("aamt.agents.scrum_master.ScrumMaster._goal_sentence",
+                        lambda self, project, plan: "Deliver the store slice.")
+    seen: dict[str, tuple[str, object]] = {}
+
+    def fake_run_task(task, *, workspace_root, agent_role, **kw):
+        seen[task.title] = (kw["project_summary"], kw["context"])
+        ws = Workspace(workspace_root)
+        ws.ensure_git_repo()
+        ws.create_branch(f"task/{task.id}")
+        ws.write_file(f"src/{task.id}.py", "value = 1\n")
+        ws.commit_all(f"feat: {task.title}")
+        t = task.model_copy(deep=True)
+        t.advance_to(TaskStatus.TESTING, actor=agent_role)
+        t.transition(TaskStatus.DONE, actor=agent_role)
+        commit = ws.last_commit_hash()
+        t.add_evidence(commit=commit, actor=agent_role)
+        return TaskRunResult(task=t, outcome="done", attempts=1, branch=f"task/{task.id}", commit_hash=commit,
+                             events=[{"type": "TASK_COMPLETION_CLAIMED", "payload": {
+                                         "task_id": t.id, "attempt": 1,
+                                         "summary": f"SUMMARY: {task.title} delivered as src/{t.id}.py"}},
+                                     {"type": "TASK_COMPLETED", "payload": {"task_id": t.id, "hash": commit}}])
+
+    monkeypatch.setattr("aamt.orchestrator.orchestrator.run_task", fake_run_task)
+    monkeypatch.setattr("aamt.orchestrator.orchestrator.ReviewerAgent.review", lambda self, task, ws, **kw: __import__(
+        "aamt.integration.reviewer", fromlist=["ReviewResult"]).ReviewResult(approved=True, comments=["ok"]))
+    settings = _settings(tmp_path, enable_standups=False, enable_retro=False, inter_task_seconds=0, max_sprints=3)
+    settings.ensure_dirs()
+    monkeypatch.setattr("aamt.config.get_settings", lambda reload=False: settings)
+
+    from aamt.orchestrator import Orchestrator
+
+    orch = Orchestrator(settings)
+    project = orch.run(name="demo", problem_statement="build a task list store", repo_path=str(tmp_path / "repo"),
+                       acceptance_criteria=["pytest passes"], max_sprints=3)
+    assert project.status.value == "COMPLETED" and orch.context.errors == []
+    first, ctx1 = seen["Create store module"]
+    second, _ = seen["Add tests for store"]
+    assert "build a task list store" in first and "pytest passes" in first      # requirements from memory
+    assert "Create store module delivered" in second                            # upstream handoff
+    assert ctx1.reader.task_id and ctx1.reader.team == "backend"
+    assert (settings.data_dir / "context.db").exists()
+    assert "## Decisions" in (settings.data_dir / "reports" / "decisions.md").read_text(encoding="utf-8")
+    orch.close()
+
+
+def test_context_engine_can_be_switched_off(tmp_path, monkeypatch):
+    settings = _settings(tmp_path, enable_context_engine=False)
+    settings.ensure_dirs()
+    from aamt.orchestrator import Orchestrator
+
+    orch = Orchestrator(settings)
+    assert orch.context is None
+    project = Project(name="p", problem_statement="demo")
+    assert orch._context_for(project, Task(title="t"), None, None) == orch._project_summary(project)
+    orch.close()
